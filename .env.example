# Скопируйте в .env и заполните. Файл .env никогда не коммитится.

ENV=local                       # local | production
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db   # в проде: postgresql+asyncpg://user:pass@postgres:5432/stats
REDIS_URL=redis://localhost:6379/0

SESSION_SECRET=change-me-long-random
USER_REF_SECRET=change-me-long-random
HISTORY_ENC_KEY=                 # base64 от 32 случайных байт (шифрование TikTok-истории)

ADMIN_EMAILS=ilyaskvortsov683@gmail.com
DEV_LOGIN=true                   # вход без Google — только локально!

# Google OAuth (вход)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google сервисный аккаунт (Sheets/Drive): JSON целиком одной строкой
GOOGLE_SA_JSON=
DICT_SHEET_ID=                   # таблица словарей
OPS_SHEET_ID=                    # таблица журналов (ops_log)
LOGS_DRIVE_FOLDER_ID=            # папка для архива технических логов

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_SEND_RECEIPT=false      # самозанятость: чеки формируются в «Мой налог», receipt не передаём

# Telegram
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_WEBHOOK_SECRET=
ADMIN_TG_CHAT_ID=
